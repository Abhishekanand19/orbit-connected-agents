# Local development only. Compose publishes the database on loopback.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=orbit
# Set only when connecting to an independently secured database.
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_CONNECT_TIMEOUT=2
FALKORDB_SOCKET_TIMEOUT=5
FALKORDB_QUERY_TIMEOUT_MS=2000
ORBIT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
