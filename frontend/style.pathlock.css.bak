@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#e4e9ee;background:#101418;font-synthesis:none}*{box-sizing:border-box}body{margin:0}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}button:disabled{opacity:.45;cursor:wait}main{max-width:1600px;margin:auto;padding:0 48px}header{height:94px;display:flex;align-items:center;border-bottom:1px solid #293038;gap:28px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:#f3f6f9;font-size:25px;font-weight:700;letter-spacing:-1px}.brand>span{background:#c4dbbc;color:#182919;border-radius:10px;padding:8px;display:flex}.brand small{margin-left:16px;padding-left:24px;border-left:1px solid #394046;font-size:10px;letter-spacing:2px;color:#8c989f}.connections{margin-left:auto;display:flex;gap:23px;font-size:12px;color:#a2adae}.connections span:before{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:#7b8289;margin-right:8px}.connections .online:before{background:#b9d9a4}.avatar{border:1px solid #465046;background:#263329;border-radius:50%;width:33px;height:33px;display:grid;place-items:center;font-size:12px}.intro{display:flex;justify-content:space-between;align-items:center;padding:44px 0 32px}.eyebrow{font-size:10px;letter-spacing:2px;color:#abb8bf;font-weight:600}.eyebrow span{margin:0 12px;color:#515e67}h1{font-family:Manrope,sans-serif;font-size:37px;letter-spacing:-1.6px;margin:13px 0 10px;font-weight:500}p{color:#95a1aa;font-size:14px;line-height:1.7;margin:0}.session{font-size:11px;letter-spacing:1.5px;text-align:right;color:#c5cecb}.session small{display:block;font-size:11px;letter-spacing:0;color:#71818c;margin-top:10px}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 335px;border:1px solid #30383f;border-radius:15px;overflow:hidden;background:#151b20}.canvas{min-width:0}.canvashead{display:flex;justify-content:space-between;align-items:center;padding:23px 25px}.canvashead>span:first-child{display:flex;gap:8px;color:#aebac1;font-size:12px}.pill{font-size:10px;background:#242d34;border:1px solid #39434a;border-radius:30px;padding:6px 11px;color:#c0cbd3}.pill.good{color:#bbdbaa;background:#23332b}.graph{height:370px;position:relative;background-image:radial-gradient(#33404980 .8px,transparent .8px);background-size:20px 20px;margin:0 15px}.graph svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.graph svg path{fill:none;stroke-width:1.8}.legit{stroke:#87a781;stroke-dasharray:6 5;animation:flow 20s linear infinite}.risk{stroke:#d67b6c;stroke-dasharray:6 5;animation:flow 12s linear infinite,appear 1s ease}.cut{stroke:#4c5860;stroke-dasharray:4 12}.node{position:absolute;transform:translate(-50%,-20%);display:flex;align-items:center;flex-direction:column;gap:9px;width:125px;animation:appear .8s ease}.nodeicon{position:relative;width:61px;height:61px;display:grid;place-items:center;background:#222d31;border:1px solid #4c615c;border-radius:17px;color:#c7dfc1;box-shadow:0 0 0 6px #151b20}.nodeicon svg{position:static;width:23px;height:23px}.node strong{font-size:12px;font-weight:500}.node small{font-size:10px;color:#758891}.danger .nodeicon{color:#e9a293;border-color:#85574f;background:#332624}.cutmark{position:absolute;left:40%;top:70%;color:#b8d5ac;font-size:11px;display:flex;gap:6px;background:#151b20;padding:9px}.cutmark svg{position:static;width:18px}.graphfoot{display:flex;gap:20px;padding:15px 25px;font-size:10px;color:#8b9ba5;align-items:center}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:7px}.green{background:#accb9c}.red{background:#d48b7b}.gray{background:#65717a}.graphfoot button{margin-left:auto;background:none;border:0;color:#c3cfcb;display:flex;align-items:center;gap:5px;font-size:11px}.order{border-top:1px solid #303a40;padding:21px 25px;display:flex;align-items:center;gap:14px;background:#192127}.ordericon{color:#a1b898}.order small{display:block;font-size:9px;letter-spacing:1.5px;color:#81968b;margin-bottom:5px}.order strong{font-size:13px;font-weight:500}.shipped{margin-left:auto;color:#c1dbb6;font-size:12px;display:flex;align-items:center;gap:5px}aside{border-left:1px solid #30383f;padding:28px;background:#1a2228;display:flex;flex-direction:column;align-items:flex-start}.agenticon{margin-top:30px;width:45px;height:45px;display:grid;place-items:center;background:#29362e;border:1px solid #455a48;border-radius:12px;color:#c4dfb8}h2{font-family:Manrope,sans-serif;font-size:25px;font-weight:500;letter-spacing:-.7px;margin:20px 0 12px}aside p{font-size:12px;margin-bottom:20px}.primary{width:100%;border:1px solid #c4d9b8;background:#c4d9b8;color:#233323;border-radius:8px;padding:14px 12px;display:flex;align-items:center;justify-content:space-between;font-weight:600;font-size:12px;margin-top:auto}.real{font-size:8px;color:#7e9098;letter-spacing:1px;align-self:center;margin-top:13px}.alternatives{width:100%;margin-bottom:13px}.alternatives>div{display:flex;gap:9px;padding:10px 0;border-bottom:1px solid #354047;font-size:11px;animation:appear .6s both}.alternatives small{display:block;color:#94a09f;font-size:10px;margin-top:4px}.alternatives>div:last-child{color:#c5dfb7}.recommend{font-size:11px;color:#bcd2b0;padding:10px 0 17px}.recommend strong{display:block;margin-top:5px}.results{width:100%;margin:0 0 24px}.results>div{padding:13px 0;border-bottom:1px solid #344047;display:flex;justify-content:space-between;font-size:11px}.results strong{font-size:10px}.ok{color:#bfdbac}.bad{color:#e59c8f}.error{padding:12px;background:#402b28;color:#edb7a6;font-size:12px;margin:12px 0}.memory{display:flex;justify-content:space-between;align-items:center;padding:33px 0;border-bottom:1px solid #2b353b;gap:25px}.memory h3{font-weight:500;font-size:19px;letter-spacing:-.5px;margin:10px 0 6px}.memory p{font-size:11px}.chips{display:flex;gap:12px}.chips>span{border:1px solid #303c40;padding:17px 19px;border-radius:10px;font-size:11px;display:grid;grid-template-columns:20px 1fr;gap:8px 12px;align-items:center;background:#171e22}.chips svg{width:17px;color:#b5caa9;grid-row:span 2}.chips small{font-size:8px;letter-spacing:1px;color:#7e9587}footer{display:flex;justify-content:space-between;padding:24px 0;font-size:9px;color:#73858e}footer span:first-child{display:flex;align-items:center;gap:12px;letter-spacing:1px}.why{padding:25px;border:1px solid #50634d;border-radius:12px;margin-top:20px;background:#1e2923}.why button{float:right;background:none;color:white;border:0}.why p{padding:5px}.why b{display:inline-block;min-width:110px;color:#c0d7b4}.spin{animation:spin 1s linear infinite}.exploring .node{animation:pulse 1s infinite alternate}@keyframes spin{to{transform:rotate(360deg)}}@keyframes flow{to{stroke-dashoffset:-200}}@keyframes appear{from{opacity:0}to{opacity:1}}@keyframes pulse{to{opacity:.3}}@media(max-width:1100px){main{padding:0 22px}.workspace{grid-template-columns:1fr 300px}.chips{gap:5px}.chips>span{padding:12px}.brand small{display:none}h1{font-size:30px}}@media(max-width:800px){.workspace{grid-template-columns:1fr}aside{border-left:0;border-top:1px solid #30383f}.memory{align-items:flex-start;flex-direction:column}.session{display:none}.connections{font-size:10px;gap:10px}.graph{height:320px}.node{width:90px}.node strong{font-size:10px}.node small{font-size:8px}footer{gap:15px;flex-wrap:wrap}.primary{margin-top:20px}}@media(prefers-reduced-motion:reduce){*{animation:none!important}}
.workspace{grid-template-columns:minmax(0,1fr) 365px}aside{padding:23px}.agenticon{margin-top:16px;width:37px;height:37px}h2{font-size:23px;margin:14px 0 9px}aside p{margin-bottom:12px}.alternatives>div{padding:8px 0}.results{margin-bottom:14px}.recommend{padding:8px 0 12px}.intro{padding:32px 0 26px}.memory{padding:25px 0}.nodeicon{z-index:1}@media(max-width:800px){.workspace{grid-template-columns:1fr}}
